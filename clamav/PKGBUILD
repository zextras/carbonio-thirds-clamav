_package() {
  cd "${srcdir}"
  alien -t clamav-data-*.noarch.rpm

  cd "${srcdir}/clamav-${pkgver}"
  make DESTDIR="${pkgdir}" install

  mkdir -p "${pkgdir}/opt/zextras/data/clamav/db"
  tar -xvf "${srcdir}"/clamav-data-*.tgz \
    --strip-components=4 \
    -C "${pkgdir}/opt/zextras/data/clamav/db"

  rm -rf "${pkgdir}/usr"
  rm -rf "${pkgdir}/lib"
  rm -rf "${pkgdir}"/opt/zextras/common/bin/clamav-config
  if [ -d "${pkgdir}/opt/zextras/common/lib64" ]; then
    mv "${pkgdir}/opt/zextras/common/lib64" \
      "${pkgdir}/opt/zextras/common/lib"
  fi

  # systemd tmpfiles.d configuration
  install -Dm644 "${srcdir}/systemd-tmpfile.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/${pkgname}.conf"

  # systemd sysusers.d configuration
  install -Dm644 "${srcdir}/systemd-sysuser.conf" \
    "${pkgdir}/usr/lib/sysusers.d/${pkgname}.conf"

  # start install carbonio-clamav consul registration artifacts
  install -Dm755 "${srcdir}/carbonio-clamav" \
    "${pkgdir}/usr/bin/carbonio-clamav"

  install -Dm644 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/clamav/service-discover/policies.json"

  install -Dm644 "${srcdir}/carbonio-clamav.hcl" \
    "${pkgdir}/etc/zextras/service-discover/carbonio-clamav.hcl"

  install -Dm644 "${srcdir}/intentions.json" \
    "${pkgdir}/etc/carbonio/clamav/service-discover/intentions.json"

  install -Dm644 "${srcdir}/service-protocol.json" \
    "${pkgdir}/etc/carbonio/clamav/service-discover/service-protocol.json"

  install -Dm755 "${srcdir}/211-carbonio-clamav-setup.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/211-carbonio-clamav-setup.sh"
  # end install carbonio-clamav consul registration artifacts
}

_package_systemd() {
  # systemd units
  install -Dm644 "${srcdir}/carbonio-antivirus.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-antivirus.service"
  install -Dm644 "${srcdir}/carbonio-freshclam.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-freshclam.service"
}

_postinst() {
  # Create users and groups via systemd-sysusers
  systemd-sysusers /usr/lib/sysusers.d/carbonio-clamav.conf >/dev/null 2>&1 || :
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/carbonio-clamav.conf || :

  echo "======================================================"
  echo "Carbonio ClamAV installed successfully!"
  echo "You must run pending-setups to configure it correctly."
  echo "======================================================"
}

_postinst_legacy() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-clamav-sidecar.service >/dev/null 2>&1 || :
  fi
}

_postinst_systemd() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-antivirus.service >/dev/null 2>&1 || :
    systemctl enable carbonio-freshclam.service >/dev/null 2>&1 || :
    systemctl enable carbonio-clamav-sidecar.service >/dev/null 2>&1 || :
  fi
}

_prerm_legacy() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-clamav-sidecar.service >/dev/null 2>&1 || :
    systemctl stop carbonio-clamav-sidecar.service >/dev/null 2>&1 || :
  fi
}

_prerm_systemd() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable --now carbonio-antivirus.service >/dev/null 2>&1 || :
    systemctl --no-reload disable --now carbonio-freshclam.service >/dev/null 2>&1 || :
    systemctl --no-reload disable --now carbonio-clamav-sidecar.service >/dev/null 2>&1 || :
  fi
}

prepare() {
  # Install rustup if missing. rustup-init is fetched via yap's source array (host arch).
  if [ ! -x "$HOME/.cargo/bin/rustup" ]; then
    echo "Installing rustup from pinned rustup-init..."
    install -Dm755 "${srcdir}/rustup-init" "${srcdir}/rustup-init.bin"
    "${srcdir}/rustup-init.bin" -y --no-modify-path --default-toolchain "${_rust_version}"
  fi

  # Always make cargo/rustup available on PATH for the rest of this script.
  export PATH="$HOME/.cargo/bin:$PATH"

  # Install + default the pinned toolchain (idempotent).
  rustup default "${_rust_version}"

  # Add aarch64 target (idempotent; reinstalls if toolchain dir was wiped).

  cd "${srcdir}/clamav-${pkgver}"
  patch -Np1 -i "${srcdir}/sd_notify.patch"
}

build() {
  # Add cargo to PATH
  export PATH="$HOME/.cargo/bin:/opt/zextras/common/bin:$PATH"

  export LDFLAGS="-Wl,-rpath,/opt/zextras/common/lib -L/opt/zextras/common/lib -L/opt/zextras/common/lib64"
  export CPPFLAGS="-I/opt/zextras/common/include"
  export PKG_CONFIG_PATH="/opt/zextras/common/lib/pkgconfig:/opt/zextras/common/lib64/pkgconfig:${PKG_CONFIG_PATH}"
  # Native: PKG_CONFIG_PATH lets cmake's Find*.cmake see sibling carbonio-* libs.

  _cmake_cross_flags=""
  if [ -n "${CROSS_COMPILE}" ]; then
    # Install aarch64 Rust target here — yap only sets CROSS_COMPILE during build.
    rustup target add aarch64-unknown-linux-gnu

    # FindSYSTEMD.cmake needs systemd.pc (not libsystemd.pc); drop a stub in srcdir.
    mkdir -p "${srcdir}/pkgconfig-cross"
    install -Dm644 "${srcdir}/aarch64-systemd.pc" \
      "${srcdir}/pkgconfig-cross/systemd.pc"

    # PKG_CONFIG_LIBDIR replaces the default search path (overrides PKG_CONFIG_PATH).
    export PKG_CONFIG_LIBDIR="${srcdir}/pkgconfig-cross:/opt/zextras/common/lib/pkgconfig:/opt/zextras/common/lib64/pkgconfig:/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig"
    unset PKG_CONFIG_PATH

    # openssl-sys derives -m64 from the host; override with target-specific CFLAGS.
    export CFLAGS_AARCH64_UNKNOWN_LINUX_GNU="-I/opt/zextras/common/include"

    # Extend CMAKE_FIND_ROOT_PATH with /opt/zextras/common for sibling carbonio-* libs
    # (consumed by yap's toolchain file).
    export YAP_CMAKE_EXTRA_ROOT_PATH="/opt/zextras/common"

    # test_run_result=0 pins all six try_run probes in clamav's cmake to "success":
    #   - CheckFDPassing (FD passing via sendmsg/recvmsg)
    #   - CheckMallinfo  (glibc mallinfo present)
    #   - CheckUnamePosix (POSIX uname signature)
    #   - CheckStructPacking (#pragma pack supported)
    #   - CheckSignedRightShift (arithmetic right shift on signed)
    # Valid for glibc-aarch64; revisit if/when targeting musl or non-aarch64.
    _cmake_cross_flags="-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE} \
      -DOPENSSL_ROOT_DIR=/opt/zextras/common \
      -DOPENSSL_INCLUDE_DIR=/opt/zextras/common/include \
      -DOPENSSL_CRYPTO_LIBRARY=/opt/zextras/common/lib/libcrypto.so \
      -DOPENSSL_SSL_LIBRARY=/opt/zextras/common/lib/libssl.so \
      -DCMAKE_PREFIX_PATH=/opt/zextras/common \
      -DCMAKE_FIND_ROOT_PATH=/opt/zextras/common \
      -Dtest_run_result=0 \
      -Dtest_run_result__TRYRUN_OUTPUT="" \
      -DRUST_COMPILER_TARGET=aarch64-unknown-linux-gnu"
  fi

  cd "${srcdir}/clamav-${pkgver}"

  cmake . \
    -DCMAKE_INSTALL_PREFIX=/opt/zextras/common \
    -DCLAMAV_USER=zextras \
    -DCLAMAV_GROUP=zextras \
    -DAPP_CONFIG_DIRECTORY=/opt/zextras/conf \
    -DCVD_CERTS_DIRECTORY=/opt/zextras/conf/certs \
    -DENABLE_MILTER=false \
    -DENABLE_SYSTEMD=ON \
    -DENABLE_TESTS=OFF \
    ${_cmake_cross_flags}

  _jobs=$(($(nproc) / 2))
  [ "$_jobs" -lt 1 ] && _jobs=1
  make -j"$_jobs"
}

package() {
  _package
  _package_systemd

  install -Dm644 "${srcdir}/carbonio-clamav-sidecar.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-clamav-sidecar.service"
}

